        <mxCell id="heading" value="October 18 release · dependency map" style="text;html=1;align=left;verticalAlign=middle;fontSize=30;fontStyle=1;fontColor=#172b4d;" vertex="1" parent="1"><mxGeometry x="55" y="30" width="1530" height="45" as="geometry"/></mxCell>
        <mxCell id="subtitle" value="Working draft · Four parallel tracks · Arrows show prerequisites, not dates · Weekly targets are on page 2" style="text;html=1;align=left;verticalAlign=middle;fontSize=17;fontColor=#45566c;" vertex="1" parent="1"><mxGeometry x="55" y="83" width="1900" height="35" as="geometry"/></mxCell>
        <mxCell id="scope" value="&lt;b&gt;Required:&lt;/b&gt; public hierarchy service over a custom Nostr protocol · Notedeck browsing · open-weight masks + prominence model · full architecture and code&lt;br&gt;&lt;b&gt;Corpus:&lt;/b&gt; broad subject coverage · English kind-1 top-level posts · exclude replies and quote posts · useful coverage determines the required size&lt;br&gt;&lt;b&gt;Constraints:&lt;/b&gt; October 18, 2026 · $1,000 lifetime paid-resource cap · static launch snapshot is acceptable; document a continual-update path" style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;fillColor=#f3f5f8;strokeColor=#d7dee8;align=left;spacing=12;fontSize=15;fontColor=#24364b;" vertex="1" parent="1"><mxGeometry x="55" y="135" width="1945" height="80" as="geometry"/></mxCell>

        <mxCell id="lane-h" value="" style="rounded=1;arcSize=8;fillColor=#f4f7fc;strokeColor=#d7e1ef;" vertex="1" parent="1"><mxGeometry x="40" y="225" width="1980" height="195" as="geometry"/></mxCell>
        <mxCell id="lane-m" value="" style="rounded=1;arcSize=8;fillColor=#f7f5fb;strokeColor=#e1daed;" vertex="1" parent="1"><mxGeometry x="40" y="485" width="1980" height="250" as="geometry"/></mxCell>
        <mxCell id="lane-s" value="" style="rounded=1;arcSize=8;fillColor=#f1f8f6;strokeColor=#d1e5df;" vertex="1" parent="1"><mxGeometry x="40" y="805" width="1980" height="215" as="geometry"/></mxCell>
        <mxCell id="lane-d" value="" style="rounded=1;arcSize=8;fillColor=#fcf7ee;strokeColor=#e9ddc9;" vertex="1" parent="1"><mxGeometry x="40" y="1080" width="1980" height="235" as="geometry"/></mxCell>
        <mxCell id="label-h" value="&lt;b&gt;HIERARCHY&lt;br&gt;QUALITY&lt;/b&gt;&lt;br&gt;&lt;br&gt;Useful categories&lt;br&gt;and browsing paths" style="text;html=1;align=left;verticalAlign=middle;fontSize=16;fontColor=#344963;" vertex="1" parent="1"><mxGeometry x="65" y="265" width="160" height="125" as="geometry"/></mxCell>
        <mxCell id="label-m" value="&lt;b&gt;MODEL&lt;/b&gt;&lt;br&gt;&lt;br&gt;Note → masks&lt;br&gt;+ prominence" style="text;html=1;align=left;verticalAlign=middle;fontSize=16;fontColor=#59446e;" vertex="1" parent="1"><mxGeometry x="65" y="545" width="160" height="125" as="geometry"/></mxCell>
        <mxCell id="label-s" value="&lt;b&gt;SCALE&lt;/b&gt;&lt;br&gt;&lt;br&gt;Make the full build&lt;br&gt;practical and affordable" style="text;html=1;align=left;verticalAlign=middle;fontSize=16;fontColor=#365e52;" vertex="1" parent="1"><mxGeometry x="65" y="855" width="175" height="120" as="geometry"/></mxCell>
        <mxCell id="label-d" value="&lt;b&gt;DELIVERY&lt;/b&gt;&lt;br&gt;&lt;br&gt;A public service&lt;br&gt;people can browse" style="text;html=1;align=left;verticalAlign=middle;fontSize=16;fontColor=#6a5330;" vertex="1" parent="1"><mxGeometry x="65" y="1130" width="160" height="125" as="geometry"/></mxCell>

        <mxCell id="h1" value="&lt;b&gt;01 · SP + MP corrected&lt;/b&gt;&lt;br&gt;&lt;br&gt;Subject coverage and mask scope&lt;br&gt;match the reviewed requirements.&lt;br&gt;&lt;br&gt;&lt;font color=&quot;#175fa8&quot;&gt;IN PROGRESS&lt;/font&gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#e7f1ff;strokeColor=#3780ca;strokeWidth=2;align=left;spacing=15;fontSize=15;fontColor=#1e334d;" vertex="1" parent="1"><mxGeometry x="260" y="265" width="290" height="150" as="geometry"/></mxCell>
        <mxCell id="h2" value="&lt;b&gt;02 · Good 100-note hierarchy&lt;/b&gt;&lt;br&gt;&lt;br&gt;Run pipeline; review browsing.&lt;br&gt;Clear choices, meaningful narrowing,&lt;br&gt;and relevant notes.&lt;br&gt;&lt;font color=&quot;#6b7788&quot;&gt;WAITING FOR 01&lt;/font&gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#97a8bc;align=left;spacing=15;fontSize=15;fontColor=#1e334d;" vertex="1" parent="1"><mxGeometry x="620" y="265" width="290" height="150" as="geometry"/></mxCell>
        <mxCell id="h3" value="&lt;b&gt;03 · Good 500-note hierarchy&lt;/b&gt;&lt;br&gt;&lt;br&gt;200 / 2 topics → 300 / 3 → 500 / 5.&lt;br&gt;Retain notes; recheck browsing quality.&lt;br&gt;Validate prominence in browsing.&lt;br&gt;&lt;font color=&quot;#6b7788&quot;&gt;WAITING FOR 02 + 04&lt;/font&gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#97a8bc;align=left;spacing=15;fontSize=15;fontColor=#1e334d;" vertex="1" parent="1"><mxGeometry x="980" y="265" width="290" height="150" as="geometry"/></mxCell>
        <mxCell id="h-note" value="&lt;b&gt;Inside each hierarchy build&lt;/b&gt;&lt;br&gt;Subjects → masks → SSE → flat HDBSCAN groups.&lt;br&gt;Generate a category description for each group.&lt;br&gt;TRUE compares descriptions: does A contain B?&lt;br&gt;Those parent–child links form the hierarchy.&lt;br&gt;&lt;br&gt;Separate operation: recover missing category memberships." style="text;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;fontSize=15;fontColor=#45566c;" vertex="1" parent="1"><mxGeometry x="1360" y="255" width="600" height="140" as="geometry"/></mxCell>

        <mxCell id="m0" value="&lt;b&gt;04 · Prominence supervision&lt;/b&gt;&lt;br&gt;&lt;br&gt;Define the score for current masks.&lt;br&gt;Develop and review its prompt.&lt;br&gt;Set the training-output format.&lt;br&gt;&lt;font color=&quot;#176c58&quot;&gt;READY TO DEFINE&lt;/font&gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#5c9b88;align=left;spacing=15;fontSize=15;fontColor=#1e334d;" vertex="1" parent="1"><mxGeometry x="260" y="545" width="290" height="150" as="geometry"/></mxCell>
        <mxCell id="m1" value="&lt;b&gt;05 · Reviewed pilot data&lt;/b&gt;&lt;br&gt;&lt;br&gt;Masks + prominence; varied notes.&lt;br&gt;~1,000 training notes proposed.&lt;br&gt;Separate held-out evaluation notes.&lt;br&gt;&lt;font color=&quot;#6b7788&quot;&gt;WAITING FOR 01 + 04&lt;/font&gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#97a8bc;align=left;spacing=15;fontSize=15;fontColor=#1e334d;" vertex="1" parent="1"><mxGeometry x="620" y="545" width="290" height="150" as="geometry"/></mxCell>
        <mxCell id="m2" value="&lt;b&gt;06 · Model comparison&lt;/b&gt;&lt;br&gt;&lt;br&gt;Vast.ai pilots + untuned baselines.&lt;br&gt;Compare quality, speed and cost.&lt;br&gt;Select a model for the larger run.&lt;br&gt;&lt;font color=&quot;#6b7788&quot;&gt;WAITING FOR 05&lt;/font&gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#97a8bc;align=left;spacing=15;fontSize=15;fontColor=#1e334d;" vertex="1" parent="1"><mxGeometry x="980" y="545" width="290" height="150" as="geometry"/></mxCell>
        <mxCell id="m3" value="&lt;b&gt;07 · Bulk training data&lt;/b&gt;&lt;br&gt;&lt;br&gt;Generate with validated prompts.&lt;br&gt;Check quality across varied notes.&lt;br&gt;Preserve training/evaluation splits.&lt;br&gt;&lt;font color=&quot;#6b7788&quot;&gt;WAITING FOR 03&lt;/font&gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#97a8bc;align=left;spacing=15;fontSize=15;fontColor=#1e334d;" vertex="1" parent="1"><mxGeometry x="1340" y="545" width="290" height="150" as="geometry"/></mxCell>
        <mxCell id="m4" value="&lt;b&gt;08 · Trained release model&lt;/b&gt;&lt;br&gt;&lt;br&gt;Fine-tune selected model on Vast.ai.&lt;br&gt;Verify held-out masks + prominence,&lt;br&gt;runtime and weight-release terms.&lt;br&gt;&lt;font color=&quot;#6b7788&quot;&gt;WAITING FOR 06 + 07&lt;/font&gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#97a8bc;align=left;spacing=15;fontSize=15;fontColor=#1e334d;" vertex="1" parent="1"><mxGeometry x="1700" y="545" width="290" height="150" as="geometry"/></mxCell>

        <mxCell id="s1" value="&lt;b&gt;09 · Release corpus selected&lt;/b&gt;&lt;br&gt;&lt;br&gt;Start from existing 3.51M candidates.&lt;br&gt;Apply the agreed English-post scope.&lt;br&gt;Freeze selected IDs; final size open.&lt;br&gt;&lt;font color=&quot;#996200&quot;&gt;SELECTION OPEN&lt;/font&gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#fff4da;strokeColor=#cda24e;align=left;spacing=15;fontSize=15;fontColor=#1e334d;" vertex="1" parent="1"><mxGeometry x="260" y="855" width="290" height="150" as="geometry"/></mxCell>
        <mxCell id="s2" value="&lt;b&gt;10 · Practical large-run method&lt;/b&gt;&lt;br&gt;&lt;br&gt;Measure build cost and memory.&lt;br&gt;Fix scaling bottlenecks; check&lt;br&gt;that results remain useful.&lt;br&gt;&lt;font color=&quot;#176c58&quot;&gt;CAN INVESTIGATE NOW&lt;/font&gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#5c9b88;align=left;spacing=15;fontSize=15;fontColor=#1e334d;" vertex="1" parent="1"><mxGeometry x="620" y="855" width="290" height="150" as="geometry"/></mxCell>
        <mxCell id="s3" value="&lt;b&gt;11 · End-to-end rehearsal&lt;/b&gt;&lt;br&gt;&lt;br&gt;Build a sample with the release model.&lt;br&gt;Check browsing, cost and runtime&lt;br&gt;before the full run.&lt;br&gt;&lt;font color=&quot;#6b7788&quot;&gt;WAITING FOR 03 + 08 + 10&lt;/font&gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#97a8bc;align=left;spacing=15;fontSize=15;fontColor=#1e334d;" vertex="1" parent="1"><mxGeometry x="1340" y="855" width="290" height="150" as="geometry"/></mxCell>
        <mxCell id="s4" value="&lt;b&gt;12 · Final corpus snapshot&lt;/b&gt;&lt;br&gt;&lt;br&gt;Approved build; GPU work on Vast.ai.&lt;br&gt;Inspect categories, note coverage,&lt;br&gt;ranking and reproducibility.&lt;br&gt;&lt;font color=&quot;#6b7788&quot;&gt;WAITING FOR 11 + BUDGET APPROVAL&lt;/font&gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#97a8bc;align=left;spacing=15;fontSize=15;fontColor=#1e334d;" vertex="1" parent="1"><mxGeometry x="1700" y="855" width="290" height="150" as="geometry"/></mxCell>

        <mxCell id="d1" value="&lt;b&gt;13 · Protocol agreed&lt;/b&gt;&lt;br&gt;&lt;br&gt;Custom Nostr requests + responses.&lt;br&gt;Categories, paths, notes, ordering,&lt;br&gt;pagination and snapshot versions.&lt;br&gt;&lt;font color=&quot;#176c58&quot;&gt;READY TO DESIGN&lt;/font&gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#5c9b88;align=left;spacing=15;fontSize=15;fontColor=#1e334d;" vertex="1" parent="1"><mxGeometry x="260" y="1130" width="290" height="150" as="geometry"/></mxCell>
        <mxCell id="d2" value="&lt;b&gt;14 · Service ready&lt;/b&gt;&lt;br&gt;&lt;br&gt;Serve snapshot on rented hosting.&lt;br&gt;Verify protocol, capacity, deployment.&lt;br&gt;Hosting: six months (provisional).&lt;br&gt;&lt;font color=&quot;#6b7788&quot;&gt;WAITING FOR 02 + 13&lt;/font&gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#97a8bc;align=left;spacing=15;fontSize=15;fontColor=#1e334d;" vertex="1" parent="1"><mxGeometry x="980" y="1130" width="290" height="150" as="geometry"/></mxCell>
        <mxCell id="d3" value="&lt;b&gt;15 · Notedeck ready&lt;/b&gt;&lt;br&gt;&lt;br&gt;Browse categories and chosen paths.&lt;br&gt;Retrieve and display their notes.&lt;br&gt;Test against the service.&lt;br&gt;&lt;font color=&quot;#6b7788&quot;&gt;START WITH 13; FINISH WITH 14&lt;/font&gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#97a8bc;align=left;spacing=15;fontSize=15;fontColor=#1e334d;" vertex="1" parent="1"><mxGeometry x="1340" y="1130" width="290" height="150" as="geometry"/></mxCell>
        <mxCell id="d4" value="&lt;b&gt;16 · Public launch&lt;/b&gt;&lt;br&gt;&lt;br&gt;Live hierarchy + Notedeck browsing.&lt;br&gt;Publish weights, full code,&lt;br&gt;architecture and continual-update path.&lt;br&gt;&lt;font color=&quot;#176c58&quot;&gt;TARGET · OCTOBER 18&lt;/font&gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#e3f3e8;strokeColor=#488663;strokeWidth=2;align=left;spacing=15;fontSize=15;fontColor=#1e334d;" vertex="1" parent="1"><mxGeometry x="1700" y="1130" width="290" height="150" as="geometry"/></mxCell>

