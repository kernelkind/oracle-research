        <mxCell id="label-h" value="&lt;b&gt;HIERARCHY&lt;br&gt;QUALITY&lt;/b&gt;&lt;br&gt;&lt;br&gt;Useful categories&lt;br&gt;and browsing paths" style="text;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;fontSize=16;fontColor=light-dark(#344963, #e6edf3);" vertex="1" parent="1"><mxGeometry x="68" y="397" width="179.2" height="162.5" as="geometry"/></mxCell>
        <mxCell id="label-m" value="&lt;b&gt;MODELS + DATA&lt;/b&gt;&lt;br&gt;&lt;br&gt;Generate training data;&lt;br&gt;train the mask/prominence model" style="text;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;fontSize=16;fontColor=light-dark(#59446e, #e6edf3);" vertex="1" parent="1"><mxGeometry x="68" y="801" width="179.2" height="162.5" as="geometry"/></mxCell>
        <mxCell id="label-s" value="&lt;b&gt;SCALE&lt;/b&gt;&lt;br&gt;&lt;br&gt;Time, memory and cost&lt;br&gt;of the launch hierarchy" style="text;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;fontSize=16;fontColor=light-dark(#365e52, #e6edf3);" vertex="1" parent="1"><mxGeometry x="68" y="1503" width="196" height="156" as="geometry"/></mxCell>
        <mxCell id="label-d" value="&lt;b&gt;DELIVERY&lt;/b&gt;&lt;br&gt;&lt;br&gt;A public service&lt;br&gt;people can browse" style="text;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;fontSize=16;fontColor=light-dark(#6a5330, #e6edf3);" vertex="1" parent="1"><mxGeometry x="68" y="2133.5" width="179.2" height="162.5" as="geometry"/></mxCell>

        <mxCell id="h1" value="&lt;b&gt;COMPLETE&lt;/b&gt;&lt;br&gt;&lt;b&gt;01 · Fix subject and mask prompts&lt;/b&gt;&lt;br&gt;&lt;br&gt;Subject and mask prompts finished." style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=light-dark(#f7f8fa, #303c49);strokeColor=light-dark(#cbd5e1, #7c8da1);strokeWidth=1;align=left;verticalAlign=top;spacing=18;fontSize=16;fontColor=light-dark(#45566c, #e6edf3);" vertex="1" parent="1"><mxGeometry x="286.4" y="397" width="324.8" height="235" as="geometry"/></mxCell>
        <mxCell id="h2" value="&lt;b&gt;IN PROGRESS&lt;/b&gt;&lt;br&gt;&lt;b&gt;02 · Build and review 100-note hierarchy&lt;/b&gt;&lt;br&gt;&lt;br&gt;Generation underway; review pending.&lt;br&gt;Check category choices, meaningful narrowing and relevant notes." style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=light-dark(#e7f1ff, #303c49);strokeColor=light-dark(#3780ca, #79b8ff);align=left;verticalAlign=top;spacing=18;fontSize=16;fontColor=light-dark(#1e334d, #e6edf3);strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="689.6" y="397" width="324.8" height="235" as="geometry"/></mxCell>
        <mxCell id="h3" value="&lt;b&gt;03 · Test hierarchy across more topics&lt;/b&gt;&lt;br&gt;&lt;br&gt;200 notes / 2 topics → 300 / 3 → 500 / 5.&lt;br&gt;Retain notes; recheck browsing.&lt;br&gt;Test prominence-based ordering at 500.&lt;br&gt;&lt;br&gt;&lt;font color=&quot;light-dark(#6b7788, #bac6d3)&quot;&gt;START WITH 02; FINISH WITH 04&lt;/font&gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=light-dark(#f7f8fa, #303c49);strokeColor=light-dark(#cbd5e1, #7c8da1);align=left;verticalAlign=top;spacing=18;fontSize=16;fontColor=light-dark(#45566c, #e6edf3);strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="1092.8" y="397" width="324.8" height="235" as="geometry"/></mxCell>
        <mxCell id="h-note" value="&lt;b&gt;Training labels:&lt;/b&gt; note → subjects → masks + prominence.&lt;br&gt;&lt;b&gt;Fine-tuned model:&lt;/b&gt; note → masks + prominence.&lt;br&gt;Masks → SSE vectors → flat HDBSCAN groups → category descriptions.&lt;br&gt;Cosine cutoff selects category pairs.&lt;br&gt;TRUE compares descriptions: does A contain B?&lt;br&gt;Those parent–child links form the hierarchy.&lt;br&gt;Prominence orders notes; recover missing memberships separately." style="text;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;fontSize=15;fontColor=light-dark(#45566c, #e6edf3);" vertex="1" parent="1"><mxGeometry x="1518.4" y="358" width="672" height="280.5" as="geometry"/></mxCell>

        <mxCell id="m0" value="&lt;b&gt;PAUSED&lt;/b&gt;&lt;br&gt;&lt;b&gt;04 · Define mask prominence&lt;/b&gt;&lt;br&gt;&lt;br&gt;Develop the per-note mask-prominence prompt and output format. Mask prompt finished; resumption not confirmed." style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=light-dark(#f7f8fa, #303c49);strokeColor=light-dark(#cbd5e1, #7c8da1);strokeWidth=1;align=left;verticalAlign=top;spacing=18;fontSize=16;fontColor=light-dark(#45566c, #e6edf3);" vertex="1" parent="1"><mxGeometry x="286.4" y="801" width="324.8" height="195" as="geometry"/></mxCell>
        <mxCell id="m1" value="&lt;b&gt;05 · Prepare fine-tuning pilot data&lt;/b&gt;&lt;br&gt;&lt;br&gt;Reviewed notes with masks + prominence.&lt;br&gt;~1,000 training notes proposed;&lt;br&gt;separate evaluation notes.&lt;br&gt;&lt;br&gt;&lt;font color=&quot;light-dark(#6b7788, #bac6d3)&quot;&gt;WAITING FOR 04&lt;/font&gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=light-dark(#f7f8fa, #303c49);strokeColor=light-dark(#cbd5e1, #7c8da1);align=left;verticalAlign=top;spacing=18;fontSize=16;fontColor=light-dark(#45566c, #e6edf3);strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="689.6" y="801" width="324.8" height="195" as="geometry"/></mxCell>
        <mxCell id="m2" value="&lt;b&gt;06 · Compare models to fine-tune&lt;/b&gt;&lt;br&gt;&lt;br&gt;Format examples and evaluate untuned/trial models on Vast.ai: mask/prominence quality, speed and cost.&lt;br&gt;Confirm weight-release permission before selection.&lt;br&gt;&lt;br&gt;&lt;font color=&quot;light-dark(#6b7788, #bac6d3)&quot;&gt;WAITING FOR 05 + 18&lt;/font&gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=light-dark(#f7f8fa, #303c49);strokeColor=light-dark(#cbd5e1, #7c8da1);align=left;verticalAlign=top;spacing=18;fontSize=16;fontColor=light-dark(#45566c, #e6edf3);strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="1092.8" y="801" width="324.8" height="247" as="geometry"/></mxCell>
        <mxCell id="m3" value="&lt;b&gt;07 · Generate training data&lt;/b&gt;&lt;br&gt;&lt;br&gt;Produce masks + prominence to train the released model. Quality checks remain open.&lt;br&gt;&lt;br&gt;&lt;b&gt;DATA TARGET · SEPTEMBER 27&lt;/b&gt;&lt;br&gt;&lt;br&gt;&lt;font color=&quot;light-dark(#6b7788, #bac6d3)&quot;&gt;03 + 17; VOLUME DECISION OPEN&lt;/font&gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=light-dark(#f7f8fa, #303c49);strokeColor=light-dark(#cbd5e1, #7c8da1);align=left;verticalAlign=top;spacing=18;fontSize=16;fontColor=light-dark(#45566c, #e6edf3);strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="1496" y="801" width="324.8" height="208" as="geometry"/></mxCell>
        <mxCell id="m4" value="&lt;b&gt;08 · Fine-tune the model we’ll release&lt;/b&gt;&lt;br&gt;&lt;br&gt;Train on Vast.ai; check unseen-note masks/prominence and runtime.&lt;br&gt;Prepare weights, supporting files, usage instructions and evaluation results.&lt;br&gt;Verify loading and mask/prominence generation.&lt;br&gt;&lt;br&gt;&lt;font color=&quot;light-dark(#6b7788, #bac6d3)&quot;&gt;WAITING FOR 06 + 07&lt;/font&gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=light-dark(#f7f8fa, #303c49);strokeColor=light-dark(#cbd5e1, #7c8da1);align=left;verticalAlign=top;spacing=18;fontSize=16;fontColor=light-dark(#45566c, #e6edf3);strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="1899.2" y="801" width="324.8" height="299" as="geometry"/></mxCell>
        <mxCell id="m-annotator" value="&lt;b&gt;17 · Compare training-data generators&lt;/b&gt;&lt;br&gt;&lt;br&gt;Compare models’ subject, mask and prominence labels: quality, speed, cost and terms.&lt;br&gt;Muse high vs Astra low; no model selected.&lt;br&gt;&lt;br&gt;&lt;font color=&quot;light-dark(#6b7788, #bac6d3)&quot;&gt;NEEDS 04 + 19&lt;/font&gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=light-dark(#f7f8fa, #303c49);strokeColor=light-dark(#cbd5e1, #7c8da1);align=left;verticalAlign=top;spacing=18;fontSize=16;fontColor=light-dark(#45566c, #e6edf3);strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="1496" y="1087" width="324.8" height="221" as="geometry"/></mxCell>
        <mxCell id="m-setup" value="&lt;b&gt;READY TO START&lt;/b&gt;&lt;br&gt;&lt;b&gt;18 · Prepare training code for the fine-tuning pilot&lt;/b&gt;&lt;br&gt;&lt;br&gt;Prepare code to fine-tune each candidate, save/reload its trained weights, and generate outputs for evaluation." style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=light-dark(#e6f4ea, #303c49);strokeColor=light-dark(#238636, #68d391);align=left;verticalAlign=top;spacing=18;fontSize=16;fontColor=light-dark(#14532d, #e6edf3);strokeWidth=3;" vertex="1" parent="1"><mxGeometry x="689.6" y="1087" width="324.8" height="247" as="geometry"/></mxCell>
        <mxCell id="m-annotator-prep" value="&lt;b&gt;IN PROGRESS&lt;/b&gt;&lt;br&gt;&lt;b&gt;19 · Plan training-data generator comparison&lt;/b&gt;&lt;br&gt;&lt;br&gt;Muse high vs Astra low underway. Plan subject, mask and prominence comparison: quality, speed and cost." style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=light-dark(#e7f1ff, #303c49);strokeColor=light-dark(#3780ca, #79b8ff);align=left;verticalAlign=top;spacing=18;fontSize=16;fontColor=light-dark(#1e334d, #e6edf3);strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="1092.8" y="1087" width="324.8" height="247" as="geometry"/></mxCell>

        <mxCell id="s-analysis" value="&lt;b&gt;20 · Assess full hierarchy-build resources&lt;/b&gt;&lt;br&gt;&lt;br&gt;Combine generation/stage rates with mask, category and filtered-pair counts to estimate launch-build time, memory and cost.&lt;br&gt;&lt;br&gt;&lt;font color=&quot;light-dark(#6b7788, #bac6d3)&quot;&gt;NEEDS 21 + 22&lt;/font&gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=light-dark(#f7f8fa, #303c49);strokeColor=light-dark(#cbd5e1, #7c8da1);align=left;verticalAlign=top;spacing=18;fontSize=16;fontColor=light-dark(#45566c, #e6edf3);strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="286.4" y="1477" width="324.8" height="234" as="geometry"/></mxCell>
        <mxCell id="s1" value="&lt;b&gt;09 · Choose notes for launch hierarchy&lt;/b&gt;&lt;br&gt;&lt;br&gt;Select English kind-1 posts (no replies/quotes) from 3.51M candidates. Choose size for useful coverage and an affordable build; freeze note IDs.&lt;br&gt;&lt;br&gt;&lt;font color=&quot;light-dark(#6b7788, #bac6d3)&quot;&gt;WAITING FOR 20 + SELECTION&lt;/font&gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=light-dark(#f7f8fa, #303c49);strokeColor=light-dark(#cbd5e1, #7c8da1);align=left;verticalAlign=top;spacing=18;fontSize=16;fontColor=light-dark(#45566c, #e6edf3);strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="689.6" y="1477" width="324.8" height="234" as="geometry"/></mxCell>
        <mxCell id="s2" value="&lt;b&gt;10 · Check full-build time and cost&lt;/b&gt;&lt;br&gt;&lt;br&gt;Can our fine-tuned model produce launch-corpus masks + prominence, and the pipeline build the hierarchy, within budget and by October 18?&lt;br&gt;&lt;br&gt;&lt;font color=&quot;light-dark(#6b7788, #bac6d3)&quot;&gt;NEEDS 08 + 09 + 20&lt;/font&gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=light-dark(#f7f8fa, #303c49);strokeColor=light-dark(#cbd5e1, #7c8da1);align=left;verticalAlign=top;spacing=18;fontSize=16;fontColor=light-dark(#45566c, #e6edf3);strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="1092.8" y="1477" width="324.8" height="234" as="geometry"/></mxCell>
        <mxCell id="s3" value="&lt;b&gt;11 · Test hierarchy with fine-tuned model&lt;/b&gt;&lt;br&gt;&lt;br&gt;Build a sample hierarchy from its masks + prominence; check browsing and complete-pipeline operation.&lt;br&gt;&lt;br&gt;&lt;font color=&quot;light-dark(#6b7788, #bac6d3)&quot;&gt;NEEDS 03 + 08&lt;/font&gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=light-dark(#f7f8fa, #303c49);strokeColor=light-dark(#cbd5e1, #7c8da1);align=left;verticalAlign=top;spacing=18;fontSize=16;fontColor=light-dark(#45566c, #e6edf3);strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="1496" y="1477" width="324.8" height="234" as="geometry"/></mxCell>
        <mxCell id="s4" value="&lt;b&gt;12 · Build launch hierarchy snapshot&lt;/b&gt;&lt;br&gt;&lt;br&gt;Use the fine-tuned model’s masks + prominence to build the hierarchy. GPUs: Vast.ai. Check categories, coverage, ranking and reproducibility.&lt;br&gt;&lt;br&gt;&lt;b&gt;For release:&lt;/b&gt; runnable code + instructions, architecture and continual-update path matching this build.&lt;br&gt;&lt;br&gt;&lt;font color=&quot;light-dark(#6b7788, #bac6d3)&quot;&gt;NEEDS 10 + 11&lt;br&gt;AND BUDGET APPROVAL&lt;/font&gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=light-dark(#f7f8fa, #303c49);strokeColor=light-dark(#cbd5e1, #7c8da1);align=left;verticalAlign=top;spacing=18;fontSize=16;fontColor=light-dark(#45566c, #e6edf3);strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="1899.2" y="1477" width="324.8" height="350" as="geometry"/></mxCell>
        <mxCell id="s-hdbscan" value="&lt;b&gt;READY TO START&lt;/b&gt;&lt;br&gt;&lt;b&gt;21 · Assess HDBSCAN at launch scale&lt;/b&gt;&lt;br&gt;&lt;br&gt;Can HDBSCAN form our mask-vector groups at the intended corpus size within budget and deadline?&lt;br&gt;Identify work needed." style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=light-dark(#e6f4ea, #303c49);strokeColor=light-dark(#238636, #68d391);align=left;verticalAlign=top;spacing=18;fontSize=16;fontColor=light-dark(#14532d, #e6edf3);strokeWidth=3;" vertex="1" parent="1"><mxGeometry x="286.4" y="1750" width="324.8" height="234" as="geometry"/></mxCell>
        <mxCell id="s-stage-costs" value="&lt;b&gt;READY TO START&lt;/b&gt;&lt;br&gt;&lt;b&gt;22 · Measure SSE, category-title and TRUE processing costs&lt;/b&gt;&lt;br&gt;&lt;br&gt;Use existing masks and categories to measure time, memory and cost for these three stages." style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=light-dark(#e6f4ea, #303c49);strokeColor=light-dark(#238636, #68d391);align=left;verticalAlign=top;spacing=18;fontSize=16;fontColor=light-dark(#14532d, #e6edf3);strokeWidth=3;" vertex="1" parent="1"><mxGeometry x="689.6" y="1750" width="324.8" height="234" as="geometry"/></mxCell>

        <mxCell id="d1" value="&lt;b&gt;READY TO START&lt;/b&gt;&lt;br&gt;&lt;b&gt;13 · Define Nostr hierarchy protocol&lt;/b&gt;&lt;br&gt;&lt;br&gt;Specify requests/responses for browsing categories, paths and ordered notes, pagination and snapshot versions." style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=light-dark(#e6f4ea, #303c49);strokeColor=light-dark(#238636, #68d391);align=left;verticalAlign=top;spacing=18;fontSize=16;fontColor=light-dark(#14532d, #e6edf3);strokeWidth=3;" vertex="1" parent="1"><mxGeometry x="286.4" y="2133.5" width="324.8" height="195" as="geometry"/></mxCell>
        <mxCell id="d2" value="&lt;b&gt;14 · Build public hierarchy service&lt;/b&gt;&lt;br&gt;&lt;br&gt;Serve a saved hierarchy via our Nostr protocol on rented hosting.&lt;br&gt;Test capacity and deployment.&lt;br&gt;Six months hosting: provisional.&lt;br&gt;&lt;br&gt;&lt;font color=&quot;light-dark(#6b7788, #bac6d3)&quot;&gt;WAITING FOR 02 + 13&lt;/font&gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=light-dark(#f7f8fa, #303c49);strokeColor=light-dark(#cbd5e1, #7c8da1);align=left;verticalAlign=top;spacing=18;fontSize=16;fontColor=light-dark(#45566c, #e6edf3);strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="1092.8" y="2133.5" width="324.8" height="195" as="geometry"/></mxCell>
        <mxCell id="d3" value="&lt;b&gt;15 · Build Notedeck hierarchy browser&lt;/b&gt;&lt;br&gt;&lt;br&gt;Browse categories and display their notes through our Nostr service; test service integration.&lt;br&gt;&lt;br&gt;&lt;font color=&quot;light-dark(#6b7788, #bac6d3)&quot;&gt;START WITH 13; FINISH WITH 14&lt;/font&gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=light-dark(#f7f8fa, #303c49);strokeColor=light-dark(#cbd5e1, #7c8da1);align=left;verticalAlign=top;spacing=18;fontSize=16;fontColor=light-dark(#45566c, #e6edf3);strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="1496" y="2133.5" width="324.8" height="195" as="geometry"/></mxCell>
        <mxCell id="d4" value="&lt;b&gt;16 · Launch public hierarchy&lt;/b&gt;&lt;br&gt;&lt;br&gt;Launch service + Notedeck; publish the prepared model (08), full code, architecture and continual-update path (12).&lt;br&gt;&lt;br&gt;&lt;b&gt;TARGET · OCTOBER 18&lt;/b&gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=light-dark(#f7f8fa, #303c49);strokeColor=light-dark(#cbd5e1, #7c8da1);strokeWidth=1;align=left;verticalAlign=top;spacing=18;fontSize=16;fontColor=light-dark(#45566c, #e6edf3);" vertex="1" parent="1"><mxGeometry x="1899.2" y="2133.5" width="324.8" height="234" as="geometry"/></mxCell>

