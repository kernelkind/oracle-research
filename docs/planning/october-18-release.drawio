  <diagram id="dependencies" name="1 — Dependencies">
    <mxGraphModel dx="2060" dy="1510" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="2060" pageHeight="1510" math="0" shadow="0" background="#ffffff">
      <root>
        <mxCell id="0"/>
