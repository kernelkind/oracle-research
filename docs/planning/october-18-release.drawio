        <mxCell id="e-d3-d4" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#516174;strokeWidth=2;jumpStyle=arc;jumpSize=8;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="d3" target="d4"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e-s4-d4" value="release snapshot" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#516174;strokeWidth=2;jumpStyle=arc;jumpSize=8;exitX=0.5;exitY=1;entryX=0.5;entryY=0;fontSize=13;fontColor=#45566c;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="s4" target="d4"><mxGeometry relative="1" as="geometry"/></mxCell>

        <mxCell id="legend" value="&lt;b&gt;How to read this&lt;/b&gt;   Solid arrow = prerequisite to finish the next result. Dashed arrow = helpful early input; the destination can start without it.&lt;br&gt;Investigations and preparation can start before every prerequisite is complete. Line crossings do not join. Box numbers are diagram references, not task-board IDs.&lt;br&gt;SP = subject prompt; MP = mask prompt. Team: user + agents; Notedeck integration: user. Other assignments remain open. Status is a planning snapshot, not a live feed." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=14;fontColor=#45566c;" vertex="1" parent="1"><mxGeometry x="55" y="1340" width="1945" height="75" as="geometry"/></mxCell>
        <mxCell id="open" value="&lt;b&gt;Still open:&lt;/b&gt; release subset/size · concrete quality judgments · training volume and model · spending allocations · hosting capacity and confirmed duration · task assignments.&lt;br&gt;This diagram authorizes no spending. Budget for Vast.ai training + snapshot GPU work, rented hosting and reruns within the $1,000 lifetime cap; paid actions need separate approval." style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;fillColor=#fff7e6;strokeColor=#e2c88f;align=left;spacing=14;fontSize=14;fontColor=#6a5330;" vertex="1" parent="1"><mxGeometry x="55" y="1430" width="1945" height="60" as="geometry"/></mxCell>
      </root>
    </mxGraphModel>
  </diagram>
  <diagram id="weekly-targets" name="2 — Proposed weekly targets">
    <mxGraphModel dx="1740" dy="990" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1740" pageHeight="990" math="0" shadow="0" background="#ffffff">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>
        <mxCell id="week-heading" value="Proposed weekly targets" style="text;html=1;align=left;verticalAlign=middle;fontSize=30;fontStyle=1;fontColor=#172b4d;" vertex="1" parent="1"><mxGeometry x="55" y="35" width="1600" height="45" as="geometry"/></mxCell>
        <mxCell id="week-subtitle" value="Your proposed sequence, preserved for discussion · These are targets, not a frozen schedule or a claim of feasibility" style="text;html=1;align=left;verticalAlign=middle;fontSize=17;fontColor=#45566c;" vertex="1" parent="1"><mxGeometry x="55" y="90" width="1600" height="35" as="geometry"/></mxCell>
        <mxCell id="week1" value="&lt;font style=&quot;font-size:22px&quot;&gt;&lt;b&gt;Week 1&lt;/b&gt;&lt;/font&gt;&lt;br&gt;&lt;br&gt;&lt;b&gt;Good 100-note hierarchy&lt;/b&gt;&lt;br&gt;&lt;br&gt;Correct the SP and MP problems&lt;br&gt;found in the 10-note batch.&lt;br&gt;&lt;br&gt;Generate and inspect the complete&lt;br&gt;100-note hierarchy.&lt;br&gt;&lt;br&gt;&lt;font color=&quot;#6b7788&quot;&gt;Map: 01–02&lt;/font&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#f4f7fc;strokeColor=#b7c8e0;align=left;verticalAlign=top;spacing=20;fontSize=16;fontColor=#1e334d;" vertex="1" parent="1"><mxGeometry x="55" y="160" width="310" height="380" as="geometry"/></mxCell>
        <mxCell id="week2" value="&lt;font style=&quot;font-size:22px&quot;&gt;&lt;b&gt;Week 2&lt;/b&gt;&lt;/font&gt;&lt;br&gt;&lt;br&gt;&lt;b&gt;Broader validation + pilots&lt;/b&gt;&lt;br&gt;&lt;br&gt;200 notes / 2 topics.&lt;br&gt;300 notes / 3 topics.&lt;br&gt;500 notes / 5 topics.&lt;br&gt;&lt;br&gt;Develop prominence and validate&lt;br&gt;it in the 500-note hierarchy.&lt;br&gt;&lt;br&gt;Small fine-tunes on several models&lt;br&gt;using ~1,000 training notes.&lt;br&gt;Begin bulk data after validation.&lt;br&gt;&lt;br&gt;&lt;font color=&quot;#6b7788&quot;&gt;Map: 03–07&lt;/font&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#f7f5fb;strokeColor=#cbbfdd;align=left;verticalAlign=top;spacing=20;fontSize=16;fontColor=#1e334d;" vertex="1" parent="1"><mxGeometry x="385" y="160" width="310" height="380" as="geometry"/></mxCell>
        <mxCell id="week3" value="&lt;font style=&quot;font-size:22px&quot;&gt;&lt;b&gt;Week 3&lt;/b&gt;&lt;/font&gt;&lt;br&gt;&lt;br&gt;&lt;b&gt;Fine-tune&lt;/b&gt;&lt;br&gt;&lt;br&gt;Train the selected model&lt;br&gt;on the larger dataset.&lt;br&gt;&lt;br&gt;&lt;font color=&quot;#6b7788&quot;&gt;Map: 08&lt;/font&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#f7f5fb;strokeColor=#cbbfdd;align=left;verticalAlign=top;spacing=20;fontSize=16;fontColor=#1e334d;" vertex="1" parent="1"><mxGeometry x="715" y="160" width="310" height="380" as="geometry"/></mxCell>
        <mxCell id="week4" value="&lt;font style=&quot;font-size:22px&quot;&gt;&lt;b&gt;Week 4&lt;/b&gt;&lt;/font&gt;&lt;br&gt;&lt;br&gt;&lt;b&gt;Corpus + service preparation&lt;/b&gt;&lt;br&gt;&lt;br&gt;Define the serving protocol.&lt;br&gt;&lt;br&gt;Generate the final corpus data&lt;br&gt;with the fine-tuned model.&lt;br&gt;&lt;br&gt;Prepare the public-service code.&lt;br&gt;&lt;br&gt;&lt;font color=&quot;#6b7788&quot;&gt;Map: 12–14&lt;/font&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#f1f8f6;strokeColor=#b1d0c5;align=left;verticalAlign=top;spacing=20;fontSize=16;fontColor=#1e334d;" vertex="1" parent="1"><mxGeometry x="1045" y="160" width="310" height="380" as="geometry"/></mxCell>
        <mxCell id="week5" value="&lt;font style=&quot;font-size:22px&quot;&gt;&lt;b&gt;Week 5&lt;/b&gt;&lt;/font&gt;&lt;br&gt;&lt;br&gt;&lt;b&gt;Integration + launch&lt;/b&gt;&lt;br&gt;&lt;br&gt;Set up the public server.&lt;br&gt;Implement the Notedeck UI.&lt;br&gt;&lt;br&gt;Publish the model weights,&lt;br&gt;code, documentation and&lt;br&gt;launch announcement.&lt;br&gt;&lt;br&gt;&lt;font color=&quot;#6b7788&quot;&gt;Map: 14–16&lt;/font&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#fcf7ee;strokeColor=#dac5a2;align=left;verticalAlign=top;spacing=20;fontSize=16;fontColor=#1e334d;" vertex="1" parent="1"><mxGeometry x="1375" y="160" width="310" height="380" as="geometry"/></mxCell>
        <mxCell id="suggestion-heading" value="Suggested adjustments · not yet scheduled decisions" style="text;html=1;align=left;verticalAlign=middle;fontSize=21;fontStyle=1;fontColor=#6a5330;" vertex="1" parent="1"><mxGeometry x="55" y="555" width="1600" height="40" as="geometry"/></mxCell>
        <mxCell id="suggestion1" value="&lt;b&gt;Separate pilot data from bulk data&lt;/b&gt;&lt;br&gt;&lt;br&gt;Pilot labels must exist before model comparison.&lt;br&gt;They should cover masks and prominence.&lt;br&gt;The larger data-generation run can wait for&lt;br&gt;the broader hierarchy validation.&lt;br&gt;&lt;br&gt;Do not treat the 500-note hierarchy corpus&lt;br&gt;as the entire training distribution." style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#fff7e6;strokeColor=#e2c88f;align=left;verticalAlign=top;spacing=20;fontSize=16;fontColor=#6a5330;" vertex="1" parent="1"><mxGeometry x="55" y="615" width="530" height="240" as="geometry"/></mxCell>
        <mxCell id="suggestion2" value="&lt;b&gt;Measure scale before the final build&lt;/b&gt;&lt;br&gt;&lt;br&gt;Start with existing artifacts; add pilot-model&lt;br&gt;measurements as they become available.&lt;br&gt;Check the complete build with the release model&lt;br&gt;before spending on the final corpus.&lt;br&gt;&lt;br&gt;Corpus selection and scaling work (09–11)&lt;br&gt;still need explicit weekly targets." style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#fff7e6;strokeColor=#e2c88f;align=left;verticalAlign=top;spacing=20;fontSize=16;fontColor=#6a5330;" vertex="1" parent="1"><mxGeometry x="605" y="615" width="530" height="240" as="geometry"/></mxCell>
        <mxCell id="suggestion3" value="&lt;b&gt;Connect service and client earlier&lt;/b&gt;&lt;br&gt;&lt;br&gt;Draft the protocol before the final corpus exists.&lt;br&gt;Aim for a basic service/client connection in&lt;br&gt;week 3 using a saved experimental snapshot.&lt;br&gt;&lt;br&gt;This would leave more of launch week for&lt;br&gt;verification and fixes. It is a proposal,&lt;br&gt;not a change to your schedule." style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#fff7e6;strokeColor=#e2c88f;align=left;verticalAlign=top;spacing=20;fontSize=16;fontColor=#6a5330;" vertex="1" parent="1"><mxGeometry x="1155" y="615" width="530" height="240" as="geometry"/></mxCell>
        <mxCell id="week-footer" value="Deadline: October 18, 2026 · Week labels follow your proposed sprint; calendar boundaries and detailed task assignments remain open.&lt;br&gt;Fine-tuning and snapshot GPU work: Vast.ai. Public endpoint: rented hosting, provisionally six months. No spending is authorized by this plan." style="text;html=1;align=left;verticalAlign=middle;fontSize=15;fontColor=#45566c;" vertex="1" parent="1"><mxGeometry x="55" y="900" width="1630" height="55" as="geometry"/></mxCell>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
