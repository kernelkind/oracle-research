        <mxCell id="heading" value="October 18 release · dependency map" style="text;html=1;align=left;verticalAlign=middle;fontSize=30;fontStyle=1;fontColor=light-dark(#172b4d, #e6edf3);" vertex="1" parent="1"><mxGeometry x="56.8" y="30" width="1713.6" height="45" as="geometry"/></mxCell>
        <mxCell id="subtitle" value="Working draft · Overall plan not approved · Four parallel tracks · Weekly targets are on page 2" style="text;html=1;align=left;verticalAlign=middle;fontSize=17;fontColor=light-dark(#45566c, #bac6d3);" vertex="1" parent="1"><mxGeometry x="56.8" y="83" width="2128" height="35" as="geometry"/></mxCell>
        <mxCell id="scope" value="&lt;b&gt;Required:&lt;/b&gt; public hierarchy service over a custom Nostr protocol · Notedeck browsing · open-weight masks + prominence model · full architecture and code&lt;br&gt;&lt;b&gt;Corpus:&lt;/b&gt; broad subject coverage · English kind-1 top-level posts · exclude replies and quote posts · useful coverage determines the required size&lt;br&gt;&lt;b&gt;Constraints:&lt;/b&gt; October 18, 2026 · $1,000 lifetime paid-resource cap · static launch snapshot is acceptable; document a continual-update path" style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;fillColor=light-dark(#f3f5f8, #202936);strokeColor=light-dark(#d7dee8, #7c8da1);align=left;spacing=12;fontSize=15;fontColor=light-dark(#24364b, #e6edf3);" vertex="1" parent="1"><mxGeometry x="56.8" y="135" width="2178.4" height="80" as="geometry"/></mxCell>
        <mxCell id="ready-summary" value="&lt;b&gt;Ready to start now · requires explicit authorization&lt;/b&gt;&lt;br&gt;13 · Define Nostr hierarchy protocol &amp;nbsp; · &amp;nbsp; 18 · Prepare training code for the fine-tuning pilot&lt;br&gt;21 · Assess HDBSCAN at launch scale &amp;nbsp; · &amp;nbsp; 22 · Measure SSE, category-title and TRUE processing costs" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=light-dark(#e6f4ea, #303c49);strokeColor=light-dark(#238636, #68d391);strokeWidth=2;align=left;verticalAlign=middle;spacing=14;fontSize=17;fontColor=light-dark(#14532d, #e6edf3);" vertex="1" parent="1"><mxGeometry x="56.8" y="230" width="2178.4" height="90" as="geometry"/></mxCell>

