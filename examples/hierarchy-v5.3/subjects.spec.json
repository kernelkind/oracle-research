{
  "schema_version": 1,
  "prompt": {
    "id": "ASv6.100",
    "path": "subjects.prompt.txt"
  },
  "dataset": {
    "adapter": "subjects",
    "path": "../../target/hierarchy-example/posts.json"
  },
  "runner": {
    "provider": "openai-codex",
    "model": "gpt-6.1-sol",
    "reasoning_effort": "medium",
    "transport": "sse",
    "timeout_seconds": 3600,
    "output_schema": {
      "type": "object",
      "properties": {
        "subjects": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "number": {
                "type": "string",
                "pattern": "^[1-9][0-9]*(\\.[1-9][0-9]*)*$"
              },
              "context": {
                "type": "string",
                "minLength": 1
              },
              "subject": {
                "type": "string",
                "minLength": 1
              }
            },
            "required": [
              "number",
              "context",
              "subject"
            ],
            "additionalProperties": false
          }
        }
      },
      "required": [
        "subjects"
      ],
      "additionalProperties": false
    },
    "prompt_cache": true,
    "runner_binary": "../../sse_multivector/run-model.sh"
  },
  "scheduling_group": "hierarchy-example"
}
