{
  "type": "object",
  "properties": {
    "coverage": {
      "type": "array",
      "minItems": 2,
      "items": {
        "type": "object",
        "properties": {
          "parent": {"type": "string", "minLength": 1},
          "child": {"type": "string", "minLength": 1},
          "conditions": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "properties": {
                "parent_phrase": {"type": "string", "minLength": 1},
                "child_phrase": {"type": ["string", "null"]},
                "status": {"enum": ["established", "counterexample", "unresolved"]},
                "basis": {"type": "string", "minLength": 1}
              },
              "required": ["parent_phrase", "child_phrase", "status", "basis"],
              "additionalProperties": false
            }
          }
        },
        "required": ["parent", "child", "conditions"],
        "additionalProperties": false
      }
    },
    "relation": {
      "enum": ["equivalent", "local_contains_canonical", "canonical_contains_local", "neither", "uncertain"]
    }
  },
  "required": ["coverage", "relation"],
  "additionalProperties": false
}
