          "items": {"$ref": "#/$defs/assessment"},
          "minItems": 2,
          "maxItems": 2
        },
        {
          "type": "array",
          "items": {"$ref": "#/$defs/assessment"},
          "minItems": 4,
          "maxItems": 4
        }
      ]
    }
  },
  "required": ["assessments"],
