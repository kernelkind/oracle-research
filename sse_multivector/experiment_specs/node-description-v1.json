{
  "schema_version": 1,
  "prompt": {
    "id": "NodeDescription-v1",
    "path": "../node-description-prompt-v1/prompt.txt"
  },
  "dataset": {
    "adapter": "node_descriptions",
    "path": "node-description-v1-source.json"
  },
  "runner": {
    "provider": "openai-codex",
    "auth_file": null,
    "model": "gpt-6.1-sol",
    "reasoning_effort": "medium",
    "concurrency": 8,
    "timeout_seconds": 600,
    "output_schema": {
      "type": "object",
      "properties": {
        "node_id": {
          "type": "string"
        },
        "node_title": {
          "type": "string"
        },
        "description": {
          "type": "string"
        }
      },
      "required": [
        "node_id",
        "node_title",
        "description"
      ],
      "additionalProperties": false
    }
  }
}
