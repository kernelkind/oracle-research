{
  "schema_version": 1,
  "prompt": {"id": "MPv3.43", "path": "../mask-prompt-goal-v1/mpv3.43-draft-v1/mask-prompt.md"},
  "dataset": {"adapter": "masks", "path": "../hierarchy-refresh-v1/subjects.json", "mask_format": "word_positions"},
  "runner": {
    "provider": "openai-codex", "auth_file": null,
    "model": "gpt-6-astra", "reasoning_effort": "low",
    "concurrency": 3, "timeout_seconds": 300,
    "output_schema": {
      "type": "object", "additionalProperties": false,
      "required": ["meaning", "expressible", "evidence", "mask"],
      "properties": {
        "meaning": {"type": "string"},
        "expressible": {"type": "boolean"},
        "evidence": {"type": "string"},
        "mask": {
          "type": "array", "items": {
            "anyOf": [
              {"type": "array", "items": {"type": "integer", "minimum": 1}, "minItems": 2, "maxItems": 2},
              {"type": "object", "additionalProperties": false, "required": ["word", "text"],
               "properties": {"word": {"type": "integer", "minimum": 1}, "text": {"type": "string", "pattern": "^\\S+$"}}}
            ]
          }
        }
      }
    }
  }
}
