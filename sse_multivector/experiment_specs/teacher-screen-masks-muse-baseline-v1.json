{
  "schema_version": 1,
  "prompt": {
    "id": "MPv3.43",
    "path": "../mask-prompt-goal-v1/mpv3.43-draft-v1/mask-prompt.md"
  },
  "dataset": {
    "adapter": "masks",
    "path": "../frontier-model-comparison-v1/sp-mp-teacher-parity-v1/mask-input-t1.json",
    "mask_format": "word_positions"
  },
  "runner": {
    "provider": "openrouter",
    "auth_file": null,
    "model": "meta/muse-spark-1.3-contributor",
    "reasoning_effort": "high",
    "timeout_seconds": 1800,
    "concurrency": 16,
    "output_schema": {
      "type": "object",
      "properties": {
        "meaning": {
          "type": "string"
        },
        "expressible": {
          "type": "boolean"
        },
        "evidence": {
          "type": "string"
        },
        "mask": {
          "type": "array",
          "items": {
            "anyOf": [
              {
                "type": "array",
                "items": {
                  "type": "integer",
                  "minimum": 1
                },
                "minItems": 2,
                "maxItems": 2
              },
              {
                "type": "object",
                "properties": {
                  "word": {
                    "type": "integer",
                    "minimum": 1
                  },
                  "text": {
                    "type": "string",
                    "pattern": "^\\S+$"
                  }
                },
                "required": [
                  "word",
                  "text"
                ],
                "additionalProperties": false
              }
            ]
          }
        }
      },
      "required": [
        "meaning",
        "expressible",
        "evidence",
        "mask"
      ],
      "additionalProperties": false
    }
  }
}
