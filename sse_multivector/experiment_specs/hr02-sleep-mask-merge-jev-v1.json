{
  "schema_version": 1,
  "prompt": {
    "id": "NMP-Jev-v1",
    "path": "../node-merge-prompt-jev-v1/prompt.txt"
  },
  "dataset": {
    "adapter": "generic",
    "path": "../../target/hierarchy-build-v1/hr02-sleep-mask-merge-v1/cases.json"
  },
  "runner": {
    "provider": "openrouter",
    "auth_file": null,
    "model": "typesafe/jev-1.13",
    "reasoning_effort": "provider-default",
    "concurrency": 10,
    "timeout_seconds": 300,
    "output_schema": {
      "type": "object",
      "required": [
        "same_topic"
      ],
      "properties": {
        "same_topic": {
          "type": "object",
          "required": [
            "type",
            "choice"
          ],
          "properties": {
            "type": {
              "const": "choice"
            },
            "choice": {
              "enum": [
                "yes",
                "no",
                "uncertain"
              ]
            }
          }
        }
      }
    }
  }
}
