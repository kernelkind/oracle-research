{
  "schema_version": 1,
  "prompt": {"id": "NSP-Astra-Masks-v1", "path": "../node-subsumption-prompt-astra-masks-v1/prompt.txt"},
  "dataset": {"adapter": "generic", "path": "../../target/hierarchy-build-v1/hr02-parent-child-astra-masks-v1/cases.json"},
  "runner": {
    "provider": "openai-codex", "auth_file": null,
    "model": "gpt-6-astra", "reasoning_effort": "low",
    "concurrency": 4, "timeout_seconds": 300,
    "output_schema": {
      "type": "object", "additionalProperties": false, "required": ["parent_child"],
      "properties": {
        "parent_child": {
          "type": "object", "additionalProperties": false, "required": ["type", "choice"],
          "properties": {
            "type": {"type": "string", "enum": ["choice"]},
            "choice": {"type": "string", "enum": ["a_parent", "b_parent", "neither", "uncertain"]}
          }
        }
      }
    }
  }
}
