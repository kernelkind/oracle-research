{
  "schema_version": 1,
  "prompt": {"id": "ASv6.99", "path": "asv6.99-hr01-post-template.txt"},
  "dataset": {
    "adapter": "subjects",
    "path": "../../target/sp-autonomous-v1/condition-source-diagnostic-v1/posts.json",
    "select": ["C001", "C002", "C003", "C004", "C005", "C006"]
  },
  "runner": {
    "provider": "openai-codex",
    "model": "gpt-6.1-sol",
    "reasoning_effort": "medium",
    "transport": "websocket",
    "timeout_seconds": 1800,
    "concurrency": 1,
    "output_schema": {
      "type": "object",
      "properties": {
        "subjects": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "number": {"type": "string", "pattern": "^[1-9][0-9]*(\\.[1-9][0-9]*)*$"},
              "context": {"type": "string", "minLength": 1},
              "subject": {"type": "string", "minLength": 1}
            },
            "required": ["number", "context", "subject"],
            "additionalProperties": false
          }
        }
      },
      "required": ["subjects"],
      "additionalProperties": false
    }
  }
}
