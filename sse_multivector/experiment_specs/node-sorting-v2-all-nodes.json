{
  "schema_version": 1,
  "prompt": {
    "id": "NodeSorting-v2",
    "path": "../node-sorting-prompt-v2/NodeSorting-v2.md"
  },
  "dataset": {
    "adapter": "node_sorting",
    "path": "node-sorting-v2-all-nodes-source.json"
  },
  "runner": {
    "provider": "openai-codex",
    "auth_file": null,
    "model": "gpt-6.1-sol",
    "reasoning_effort": "medium",
    "concurrency": 12,
    "timeout_seconds": 600,
    "output_schema": {
      "type": "object",
      "properties": {
        "sorting_score": {
          "type": "integer",
          "minimum": 0,
          "maximum": 100
        },
        "reason": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "sorting_score",
        "reason"
      ],
      "additionalProperties": false
    }
  }
}
