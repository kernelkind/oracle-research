{
  "schema_version": 1,
  "prompt": {"id": "ASv6.48", "path": "asv6.48-hr01-post-template.txt"},
  "dataset": {
    "adapter": "subjects",
    "path": "../hierarchy-refresh-v1/subjects.json",
    "select": ["N063", "N074", "N096", "N100"]
  },
  "runner": {
    "provider": "openai-codex",
    "model": "gpt-6.1-sol",
    "reasoning_effort": "xhigh",
    "transport": "websocket",
    "timeout_seconds": 1800,
    "concurrency": 4,
    "output_schema": {
      "type": "object",
      "properties": {
        "subjects": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "number": {"type": "string", "pattern": "^[1-9][0-9]*(\\.[1-9][0-9]*)*$"},
              "context": {"type": "string", "minLength": 1},
              "subject": {"type": "string", "minLength": 1}
            },
            "required": ["number", "context", "subject"],
            "additionalProperties": false
          }
        }
      },
      "required": ["subjects"],
      "additionalProperties": false
    }
  }
}
