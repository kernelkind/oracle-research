{
  "schema_version": 1,
  "prompt": {
    "id": "ASv6.95",
    "path": "asv6.95-hr01-post-template.txt"
  },
  "dataset": {
    "adapter": "subjects",
    "path": "../../target/sp-autonomous-v1/consolidation-inputs-v1/subjects.json"
  },
  "runner": {
    "provider": "openai-codex",
    "model": "gpt-6.1-sol",
    "reasoning_effort": "medium",
    "transport": "websocket",
    "timeout_seconds": 1800,
    "concurrency": 1,
    "output_schema": {
      "type": "object",
      "properties": {
        "subjects": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "number": {
                "type": "string",
                "pattern": "^[1-9][0-9]*(\\.[1-9][0-9]*)*$"
              },
              "context": {
                "type": "string",
                "minLength": 1
              },
              "subject": {
                "type": "string",
                "minLength": 1
              }
            },
            "required": [
              "number",
              "context",
              "subject"
            ],
            "additionalProperties": false
          }
        }
      },
      "required": [
        "subjects"
      ],
      "additionalProperties": false
    }
  }
}
