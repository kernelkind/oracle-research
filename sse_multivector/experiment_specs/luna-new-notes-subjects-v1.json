{
  "schema_version": 1,
  "prompt": {
    "id": "ASv6.48",
    "path": "asv6.48-post-template.txt"
  },
  "dataset": {
    "adapter": "generic",
    "path": "../experiments/luna-new-notes-v1-inputs/subjects.json"
  },
  "runner": {
    "provider": "openai-codex",
    "auth_file": null,
    "model": "gpt-6-luna",
    "reasoning_effort": "max",
    "timeout_seconds": 1800,
    "concurrency": 16,
    "output_schema": {
      "additionalProperties": false,
      "properties": {
        "subjects": {
          "items": {
            "additionalProperties": false,
            "properties": {
              "context": {
                "minLength": 1,
                "type": "string"
              },
              "number": {
                "pattern": "^[1-9][0-9]*(\\.[1-9][0-9]*)*$",
                "type": "string"
              },
              "subject": {
                "minLength": 1,
                "type": "string"
              }
            },
            "required": [
              "number",
              "context",
              "subject"
            ],
            "type": "object"
          },
          "type": "array"
        }
      },
      "required": [
        "subjects"
      ],
      "type": "object"
    }
  }
}
