/target/
/reference_map/.*.lock
__pycache__/
.model-request-history/
.budget-ledger.json.lock

# Experiment data stays local. Ignore files, not experiment directories: those
# also contain source code, tests, prompts and maintained documentation.
# Existing tracked artifacts are unaffected; these rules do not untrack them.
/sse_multivector/*-v[0-9]*/**/*.json
/sse_multivector/*-v[0-9]*/**/*.jsonl
/sse_multivector/*-v[0-9]*/**/*.csv
/sse_multivector/*-v[0-9]*/**/*.tsv
/sse_multivector/*-v[0-9]*/**/*.log
/sse_multivector/*-v[0-9]*/**/*.stdout
/sse_multivector/*-v[0-9]*/**/*.stderr
/sse_multivector/*-v[0-9]*/**/stdout.txt
/sse_multivector/*-v[0-9]*/**/stderr.txt
/sse_multivector/*-v[0-9]*/**/.*.lock

# JSON source definitions and prompt-version metadata are not run data.
!/sse_multivector/*-v[0-9]*/**/*schema.json
!/sse_multivector/*-v[0-9]*/**/schemas/**/*.json
!/sse_multivector/*-v[0-9]*/**/package.json
!/sse_multivector/*-v[0-9]*/**/package-lock.json
